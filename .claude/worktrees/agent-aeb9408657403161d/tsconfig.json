{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@secman/core": ["packages/core"],
      "@secman/crypto": ["packages/crypto"],
      "@secman/github": ["packages/github"],
      "@secman/dotenv": ["packages/dotenv"],
      "@secman/keychain": ["packages/keychain"],
      "@secman/process": ["packages/process"],
      "@secman/config": ["packages/config"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}