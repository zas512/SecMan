{
  "name": "secman",
  "version": "0.1.0",
  "private": true,
  "description": "Secure, GitHub-backed environment and secret synchronization CLI",
  "workspaces": [
    "packages/*",
    "apps/cli"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node --project tsconfig.json apps/cli/index.ts",
    "start": "node dist/apps/cli/index.js",
    "test": "jest --runInBand",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@octokit/rest": "^20.1.0",
    "argon2": "^0.41.0",
    "commander": "^11.0.0",
    "dotenv": "^16.3.1",
    "js-yaml": "^4.1.0",
    "keytar": "^7.9.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.0.13",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.13",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "keywords": [
    "cli",
    "secrets",
    "environment",
    "encryption",
    "github"
  ],
  "author": "SecMan",
  "license": "MIT",
  "type": "commonjs"
}
